# ==============================================================================
# Connect Frontend Environment Variables Template
# ==============================================================================

# Backend API URL (without trailing slash)
# Local: http://localhost:3000
# Production (Render): https://your-backend-service.onrender.com
NEXT_PUBLIC_API_URL=https://connect-uvxm.onrender.com

# Backend WebSocket / Real-time URL
# Local: http://localhost:3000
# Production (Render): https://your-backend-service.onrender.com
NEXT_PUBLIC_SOCKET_URL=https://connect-uvxm.onrender.com
