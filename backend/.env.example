# ==============================================================================
# Server & Environment
# ==============================================================================
PORT=3000
NODE_ENV=development

# ==============================================================================
# Database Configuration
# ==============================================================================
# Option 1: Single Connection URL (Neon / Supabase / Render Postgres / Railway)
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Option 2: Individual Connection Fields
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=connect

# Cloud DB SSL (Set DB_SSL=true for Neon / Supabase / Render cloud databases)
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

# ==============================================================================
# Redis (Local or Cloud e.g. Upstash)
# ==============================================================================
# REDIS_URL=rediss://default:YOUR_PASSWORD@your-upstash-endpoint.upstash.io:6379
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_TLS=false

# ==============================================================================
# Security & Authentication (JWT_SECRET must be at least 32 characters)
# ==============================================================================
JWT_SECRET=your-secret-key-change-in-production-min-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# ==============================================================================
# Frontend URL (CORS & Auth Redirects)
# ==============================================================================
# Local: http://localhost:3001
# Production: https://your-connect-app.vercel.app
FRONTEND_URL=http://localhost:3001

# ==============================================================================
# Email (SMTP) — Gmail / SendGrid / Postmark
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Connect" <noreply@connect.com>

# ==============================================================================
# Stripe Billing (Optional)
# ==============================================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_ENTERPRISE=
